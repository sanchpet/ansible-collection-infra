# Normalize text to LF in the repo and on checkout; pairs with the mixed-line-ending hook.
* text=auto eol=lf

# Linguist skips YAML as a data language by default; this repo is almost nothing else.
*.yml  linguist-detectable=true
*.yaml linguist-detectable=true
*.j2   linguist-language=Jinja

# Generated by release-please and uv, not authored.
CHANGELOG.md linguist-generated=true
uv.lock      linguist-generated=true
